# ============ 当前阶段（原型，本地运行） ============
# 无需任何环境变量即可运行：npm install && npm run dev

# ============ 阶段 1：账号与数据库（即将加入） ============
# PostgreSQL 连接串（Supabase / Neon 免费档）
DATABASE_URL=postgresql://user:password@host:5432/dbname

# 登录会话加密密钥（生成：openssl rand -base64 32）
AUTH_SECRET=please-generate-a-random-secret

# 邮箱验证码/找回密码的发送服务（Resend 免费 3000 封/月）
RESEND_API_KEY=re_xxx

# ============ 阶段 2：Google 日历同步 ============
# Google Cloud 创建 OAuth Client（Web 应用）后填入；
# 授权来源填 http://localhost:3100（开发）与生产域名
GOOGLE_CLIENT_ID=xxxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=xxxxx
